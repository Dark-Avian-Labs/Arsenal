#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY_PRODUCTION="02d7e107eed2896ca8e4bb0ff3dd5a884809a8e03c9b3b116f26a1c4f156a702e9"

# .env.production
# Production environment. Loaded when NODE_ENV=production (see .env.example
# for docs). Secrets are encrypted with dotenvx; keys live in .env.keys.
# Replace the placeholder secrets per app:
#   pnpm dotenvx set SESSION_SECRET "$(openssl rand -base64 32)" -f .env.production
#   pnpm dotenvx set CLERK_SECRET_KEY "sk_live_..." -f .env.production

# --- Server ---
PORT=3000
HOST=127.0.0.1
APP_NAME=AppBase
APP_ID=appbase
APP_PUBLIC_BASE_URL=https://appbase.darkavianlabs.com

# --- Session ---
SESSION_SECRET=encrypted:BAN+zFxsfBMVaXw4SSEoUziGGcu5G6cq6socSEz9pTZsnzHcnM1nxYLlPjmsaCdxga3hoRe5k3oT46SVAIHHv/X73ETvc6JOCgpWpk4m7yAD3cLRDCZqtU94BMGcMMAvX+TPIUEUZPOSMl5WNj3NA/rDhNCqicvGNNzHTz2vdy3c625QlhH/vy67UNeedgy+gTY=
SESSION_COOKIE_NAME=appbase.sid
SESSION_DB_PATH=./data/sessions.db

# --- Cookies / proxy (behind TLS-terminating reverse proxy) ---
TRUST_PROXY=1
SECURE_COOKIES=1
# Org-wide cookie: all Dark Avian Labs apps share one login across subdomains.
COOKIE_DOMAIN=.darkavianlabs.com

# --- Clerk (required in production; server refuses to start without keys) ---
CLERK_SECRET_KEY=encrypted:BO7rXEMOG4SDrlBNlfW3YAL2Sr4760S5hcvFrMC/eJqthgzTz2EHE3FXnu6Q9x+mboPffaplI+ueenndMeDVnpfO05spHWpU33g520uXiEAPYT7p43zFPh6S2mf+4PCPUckvqbJt+sbJTeYlmcH3Waa+Zkii55c0VFlj4cHh
VITE_CLERK_PUBLISHABLE_KEY=

# --- Client ---
VITE_BASE_PATH=/
VITE_APP_NAME=AppBase
VITE_LEGAL_ENTITY_NAME=Dark Avian Labs
VITE_SEARCH_PLACEHOLDER=Search...
VITE_SHARED_THEME_COOKIE_DOMAIN=.darkavianlabs.com

# Legal page contact details (fill in per app).
VITE_LEGAL_CONTACT_NAME=
VITE_LEGAL_CONTACT_STREET=
VITE_LEGAL_CONTACT_CITY=
VITE_LEGAL_CONTACT_PHONE=
