# Unified Arsenal host (Codex + Armory + Outfitter + BudgetPlanner)
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
APP_NAME=Arsenal
APP_ID=arsenal
TRUST_PROXY=true
SECURE_COOKIES=false
LEGAL_PAGE_URL=https://darkavianlabs.com/legal

# Clerk authentication (shared across all 4 mounted apps)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Optional: map custom hostnames to app ids (codex | armory | outfitter | budget-planner)
# ARSENAL_HOST_MAP={"codex.darkavianlabs.com":"codex","armory.darkavianlabs.com":"armory","outfitter.darkavianlabs.com":"outfitter","budget.darkavianlabs.com":"budget-planner"}
# ARSENAL_DEFAULT_APP=codex

# Sentinel telemetry
# SENTINEL_URL=http://127.0.0.1:3005
# SENTINEL_INGEST_TOKEN=...
