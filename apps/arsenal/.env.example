# Unified Arsenal host (Codex + Armory + Outfitter + BudgetPlanner)
# Do NOT set APP_ID here — each mounted sub-app uses its own hardcoded ID
# (codex, armory, outfitter, budgetplanner) for Clerk admin metadata and routing.
PORT=3000
# Production runs on 3006 (ecosystem.config.cjs); 3000 is taken by crowdsec-web-ui on shockwave.
HOST=127.0.0.1
NODE_ENV=development
TRUST_PROXY=true
SECURE_COOKIES=false
BASE_DOMAIN=darkavianlabs.com
APP_PUBLIC_BASE_URL=https://codex.darkavianlabs.com
# List all four subdomains so Clerk authorizedParties and Codex CORS accept every host:
ALLOWED_APP_ORIGINS=https://codex.darkavianlabs.com,https://armory.darkavianlabs.com,https://outfitter.darkavianlabs.com,https://budget.darkavianlabs.com
LEGAL_PAGE_URL=https://darkavianlabs.com/legal

# Clerk authentication (shared across all 4 mounted apps)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Optional: map custom hostnames to app ids (codex | armory | outfitter | budget-planner)
# ARSENAL_HOST_MAP={"codex.darkavianlabs.com":"codex","armory.darkavianlabs.com":"armory","outfitter.darkavianlabs.com":"outfitter","budget.darkavianlabs.com":"budget-planner"}
# ARSENAL_DEFAULT_APP=codex

# Sentinel telemetry
# SENTINEL_INGEST_URL=http://127.0.0.1:3005/api/ingest
# SENTINEL_INGEST_TOKEN=...
