{
  "name": "codex",
  "version": "1.81.5",
  "private": true,
  "description": "Codex - game collection tracker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm run typecheck:server && pnpm run typecheck:client",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run typecheck && tsc -p tsconfig.server.json && vite build",
    "wor:import": "node scripts/wor-import.mjs",
    "wor:import:cache": "node scripts/generate-wor-import-cache.mjs",
    "start": "node dist/server/index.js",
    "dev:client": "dotenvx run --strict -f .env.development -- vite",
    "db:init": "node scripts/db-init.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "check-format": "oxfmt --check .",
    "warframe:import": "node dist/server/import/warframe/runManualImport.js"
  },
  "dependencies": {
    "@clerk/express": "catalog:",
    "@clerk/react": "catalog:",
    "@dark-avian-labs/sentinel-agent": "workspace:*",
    "@dark-avian-labs/server-kit": "workspace:*",
    "@dark-avian-labs/ui": "workspace:*",
    "@dotenvx/dotenvx": "catalog:",
    "@fontsource-variable/cascadia-mono": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@napi-rs/lzma": "^1.5.1",
    "better-sqlite3": "catalog:",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cuimp": "^2.1.1",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.11.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clerk/testing": "catalog:",
    "@dark-avian-labs/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "domhandler": "^6.0.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "supertest": "^7.3.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
