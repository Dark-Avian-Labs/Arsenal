{
  "extends": "@dark-avian-labs/config/tsconfig.server.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["server/**/*", "shared/warframeImport/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
