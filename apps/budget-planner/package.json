{
  "name": "budget-planner",
  "version": "1.9.4",
  "private": true,
  "description": "Household budget planner — shared recurring expenses, mobile-first",
  "license": "MIT",
  "files": [
    "server",
    "shared",
    "dist/client",
    "public",
    "assets",
    "ecosystem.config.cjs",
    ".env.production"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "pnpm run typecheck:server && pnpm run typecheck:client",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.json --noEmit",
    "dev": "dotenvx run --strict -f .env.development -- node scripts/dev.mjs",
    "dev:server": "node --watch server/index.ts",
    "dev:client": "dotenvx run --strict -f .env.development -- vite",
    "build": "pnpm run typecheck && dotenvx run --strict -f .env.production -- vite build",
    "start": "node server/index.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "check-format": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "env:encrypt": "dotenvx encrypt -f .env.development && dotenvx encrypt -f .env.production",
    "env:decrypt": "dotenvx decrypt -f .env.development && dotenvx decrypt -f .env.production",
    "env:set:dev": "dotenvx set -f .env.development",
    "env:set:prod": "dotenvx set -f .env.production",
    "db:backup": "node scripts/backup-app-db.mjs"
  },
  "dependencies": {
    "@clerk/express": "catalog:",
    "@clerk/react": "catalog:",
    "@dark-avian-labs/sentinel-agent": "workspace:*",
    "@dark-avian-labs/server-kit": "workspace:*",
    "@dark-avian-labs/ui": "workspace:*",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@dotenvx/dotenvx": "catalog:",
    "@fontsource-variable/cascadia-mono": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "better-sqlite3": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:",
    "i18next": "^26.4.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "^17.0.16",
    "react-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clerk/testing": "catalog:",
    "@dark-avian-labs/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "supertest": "^7.3.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
