{
  "name": "armory",
  "version": "1.74.5",
  "private": true,
  "description": "Armory - Warframe Mod Builder/Planner",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "dev:client": "dotenvx run --strict -f .env.development -- vite",
    "start": "node dist/server/index.js",
    "data:import": "node dist/server/import/runCatalogSync.js",
    "catalog:sync": "node dist/server/import/runCatalogSync.js",
    "data:migrate-artifact-slots": "node dist/server/import/runMigrateArtifactSlots.js",
    "data:rank-exceptions": "node scripts/generate-warframe-rank-exceptions.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "check-format": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@clerk/express": "catalog:",
    "@clerk/react": "catalog:",
    "@dark-avian-labs/sentinel-agent": "workspace:*",
    "@dotenvx/dotenvx": "catalog:",
    "@fontsource-variable/cascadia-mono": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@fontsource-variable/material-symbols-rounded": "^5.3.8",
    "@napi-rs/lzma": "^1.5.1",
    "better-sqlite3": "catalog:",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "csrf-sync": "^4.2.1",
    "cuimp": "^2.1.1",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "express-session": "^1.19.0",
    "helmet": "catalog:",
    "html-to-image": "^1.11.13",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "undici": "^8.11.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clerk/testing": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "catalog:",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "catalog:",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "domhandler": "^6.0.1",
    "happy-dom": "^20.14.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "supertest": "^7.3.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
