{
  "name": "armory",
  "version": "1.74.5",
  "private": true,
  "description": "Armory - Warframe Mod Builder/Planner",
  "license": "MIT",
  "files": [
    "server",
    "shared",
    "dist/client",
    "public",
    "icons",
    "ecosystem.config.cjs",
    ".env.production",
    "scripts/data"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "dev": "node --watch server/index.ts",
    "dev:client": "dotenvx run --strict -f .env.development -- vite",
    "start": "node server/index.ts",
    "data:import": "node server/import/runCatalogSync.ts",
    "catalog:sync": "node server/import/runCatalogSync.ts",
    "data:migrate-artifact-slots": "node server/import/runMigrateArtifactSlots.ts",
    "data:rank-exceptions": "node scripts/generate-warframe-rank-exceptions.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "check-format": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@clerk/express": "catalog:",
    "@dark-avian-labs/sentinel-agent": "workspace:*",
    "@dark-avian-labs/server-kit": "workspace:*",
    "@dotenvx/dotenvx": "catalog:",
    "@napi-rs/lzma": "^1.5.1",
    "better-sqlite3": "catalog:",
    "cheerio": "^1.2.0",
    "cuimp": "^2.1.1",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:",
    "undici": "^8.11.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clerk/react": "catalog:",
    "@clerk/testing": "catalog:",
    "@dark-avian-labs/config": "workspace:*",
    "@dark-avian-labs/ui": "workspace:*",
    "@fontsource-variable/cascadia-mono": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "domhandler": "^6.0.1",
    "happy-dom": "^20.14.6",
    "html-to-image": "^1.11.13",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "supertest": "^7.3.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
