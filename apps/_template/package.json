{
  "name": "dal-template",
  "version": "1.0.0",
  "private": true,
  "description": "AppBase - Base for all apps",
  "files": [
    "server",
    "dist/client",
    "public",
    "assets",
    "ecosystem.config.cjs",
    ".env.production"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "pnpm run typecheck:server && pnpm run typecheck:client",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.json --noEmit",
    "dev": "dotenvx run --strict -f .env.development -- node ../../scripts/dev.mjs",
    "dev:server": "node --watch server/index.ts",
    "dev:client": "vite",
    "build": "pnpm run typecheck && vite build",
    "start": "node server/index.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "check-format": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@clerk/express": "catalog:",
    "@dark-avian-labs/sentinel-agent": "workspace:*",
    "@dark-avian-labs/server-kit": "workspace:*",
    "@dotenvx/dotenvx": "catalog:",
    "better-sqlite3": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:"
  },
  "devDependencies": {
    "@clerk/react": "catalog:",
    "@clerk/testing": "catalog:",
    "@dark-avian-labs/config": "workspace:*",
    "@dark-avian-labs/ui": "workspace:*",
    "@fontsource-variable/cascadia-mono": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "supertest": "^7.3.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
