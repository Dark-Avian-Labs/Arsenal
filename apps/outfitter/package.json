{
  "name": "outfitter",
  "version": "1.28.4",
  "private": true,
  "description": "Watcher of Realms equipment manager and optimizer",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm run typecheck:server && pnpm run typecheck:client",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.json --noEmit",
    "dev": "dotenvx run --strict -f .env.development -- node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "pnpm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "check-format": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/express": "catalog:",
    "@clerk/react": "catalog:",
    "@dark-avian-labs/sentinel-agent": "workspace:*",
    "@dark-avian-labs/server-kit": "workspace:*",
    "@dark-avian-labs/ui": "workspace:*",
    "@dotenvx/dotenvx": "catalog:",
    "@fontsource-variable/cascadia-mono": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "better-sqlite3": "catalog:",
    "cookie-parser": "^1.4.7",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@clerk/testing": "catalog:",
    "@dark-avian-labs/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "supertest": "^7.3.1",
    "tailwindcss": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
