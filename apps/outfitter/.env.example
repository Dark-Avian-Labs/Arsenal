# ============================================================================
# Outfitter environment template
# ============================================================================
# The app loads `.env.<NODE_ENV>` in-process at startup (see server/config.ts):
#   NODE_ENV=development -> .env.development
#   NODE_ENV=production  -> .env.production
#   NODE_ENV=test        -> .env.test (optional)
# NODE_ENV itself is set by the process manager (PM2, systemd, dev script),
# never inside these files.
#
# Secrets in the committed env files are encrypted with dotenvx:
#   pnpm dotenvx encrypt -f .env.production -k SESSION_SECRET -k CLERK_SECRET_KEY
# The matching private keys live in `.env.keys` (gitignored - back it up
# somewhere safe, e.g. the deployment host and a password manager).
# Non-secret values (everything VITE_*) stay plaintext so `vite build` can
# read them without decryption.
#
# Org port map: AppBase 3000, BudgetPlanner 3001, Armory 3002, Codex 3001, Outfitter 3004.

# --- Server ---
PORT=3004
HOST=127.0.0.1
APP_NAME=Outfitter
APP_ID=outfitter

# Public origin of this deployment; required when Clerk is enabled (used for
# Clerk authorizedParties). Example: https://outfitter.darkavianlabs.com
APP_PUBLIC_BASE_URL=http://127.0.0.1:3004

# Extra origins allowed as Clerk authorized parties (comma-separated).
# Sibling apps that share Clerk sessions via COOKIE_DOMAIN=.darkavianlabs.com.
ALLOWED_APP_ORIGINS=https://codex.darkavianlabs.com,https://armory.darkavianlabs.com,https://outfitter.darkavianlabs.com,https://budget.darkavianlabs.com

# --- Session ---
# Generate a strong random string (32+ chars), e.g.: openssl rand -base64 32
# Required (and length-enforced) in production.
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_COOKIE_NAME=outfitter.sid
SESSION_DB_PATH=./data/sessions.db
APP_DB_PATH=./data/outfitter.db
HERO_IMAGES_DIR=./data/hero-images

# Read-only Codex Watcher of Realms catalog DB (heroes/artifacts/demons + wiki stats).
CODEX_WOR_DB_PATH=../Codex/data/wor-catalog.db
CODEX_WOR_IMAGES_DIR=../Codex/data/wor-images

# --- Cookies / proxy ---
# Production runs behind a reverse proxy with TLS: enable both.
TRUST_PROXY=0
SECURE_COOKIES=0
# Intentionally org-wide in production (.darkavianlabs.com): all Dark Avian
# Labs apps share one Clerk login and the theme cookie across subdomains.
# Leave empty for a host-only cookie.
#COOKIE_DOMAIN=.darkavianlabs.com

# --- Clerk authentication ---
# Leave both empty to run without authentication (development convenience).
# Production refuses to start without them. Outfitter requires login for inventory.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Override the Clerk frontend-API origin used in the CSP (defaults to
# https://clerk.darkavianlabs.com).
#CLERK_FAPI_URL=
# Cursor agent user id on the Clerk development instance. Email and password are Forgejo secrets.
E2E_CLERK_USER_ID=

# --- Graceful shutdown ---
#SHUTDOWN_TIMEOUT_MS=10000

# --- Sentinel monitoring agent (optional) ---
#SENTINEL_INGEST_URL=http://127.0.0.1:3005/api/ingest
#SENTINEL_INGEST_TOKEN=

# --- Client (Vite dev server + build-time, must stay plaintext) ---
VITE_DEV_API_TARGET=http://127.0.0.1:3004
VITE_DEV_PORT=5174
VITE_BASE_PATH=/
VITE_APP_NAME=Outfitter
VITE_LEGAL_ENTITY_NAME=Dark Avian Labs
VITE_LEGAL_PAGE_URL=https://darkavianlabs.com/legal
#VITE_SHARED_THEME_COOKIE_DOMAIN=.darkavianlabs.com
