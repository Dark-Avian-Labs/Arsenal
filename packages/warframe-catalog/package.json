{
  "name": "@dark-avian-labs/warframe-catalog",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "scripts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "rank-exceptions": "node scripts/generate-warframe-rank-exceptions.mjs"
  },
  "dependencies": {
    "@dark-avian-labs/server-kit": "workspace:*",
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@dark-avian-labs/config": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
