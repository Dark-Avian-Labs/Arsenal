# Server
PORT=3002
HOST=127.0.0.1
NODE_ENV=production
APP_NAME=AppBase
APP_ID=appbase

# Session — generate a strong random string (32+ characters)
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_COOKIE_NAME=appbase.sid

# Behind reverse proxy
TRUST_PROXY=1
SECURE_COOKIES=1
COOKIE_DOMAIN=.darkavianlabs.com

# Session store (SQLite)
SESSION_DB_PATH=./data/sessions.db

# Client (Vite dev server + build-time)
VITE_DEV_API_TARGET=http://127.0.0.1:3002
VITE_DEV_PORT=5173
VITE_BASE_PATH=/
VITE_APP_NAME=AppBase
VITE_LEGAL_ENTITY_NAME=Dark Avian Labs
VITE_SEARCH_PLACEHOLDER=Search scaffold...
VITE_SHARED_THEME_COOKIE_DOMAIN=.darkavianlabs.com
