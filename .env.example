# Server
PORT=3002
HOST=127.0.0.1
APP_NAME=AppBase
APP_ID=appbase

# Session secret — generate a strong random string (32+ characters)
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_COOKIE_NAME=appbase.sid

# Behind reverse proxy
TRUST_PROXY=1
SECURE_COOKIES=1
COOKIE_DOMAIN=.darkavianlabs.com

# Central Auth service
AUTH_SERVICE_URL=https://auth.darkavianlabs.com
AUTH_FALLBACK_SERVICE_URL=https://auth.darkavianlabs.com
APP_PUBLIC_BASE_URL=https://appbase.darkavianlabs.com
AUTH_FETCH_TIMEOUT_MS=5000

# Client
VITE_AUTH_ADMIN_URL=https://auth.darkavianlabs.com/admin
VITE_SHARED_THEME_COOKIE_DOMAIN=.darkavianlabs.com

# Data
CENTRAL_DB_PATH=/var/www/applications/auth/data/central.db